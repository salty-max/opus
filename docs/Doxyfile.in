# Doxygen configuration for the public API reference. Every public symbol
# under engine/include must carry a /// comment: an undocumented one is a
# warning, and warnings fail the build.

PROJECT_NAME           = "Opus"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "2D game engine"
OUTPUT_DIRECTORY       = @OPUS_DOCS_OUTPUT_DIR@
INPUT                  = @PROJECT_SOURCE_DIR@/engine/include @OPUS_GENERATED_INCLUDE_DIR@
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
STRIP_FROM_PATH        = @PROJECT_SOURCE_DIR@/engine/include @OPUS_GENERATED_INCLUDE_DIR@
STRIP_FROM_INC_PATH    = @PROJECT_SOURCE_DIR@/engine/include @OPUS_GENERATED_INCLUDE_DIR@
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
JAVADOC_AUTOBRIEF      = YES
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = NO
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
